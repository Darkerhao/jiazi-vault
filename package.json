{
  "name": "jiazi-vault",
  "private": true,
  "version": "0.1.24",
  "packageManager": "pnpm@9.12.1",
  "description": "Local encrypted credential vault for developers",
  "type": "module",
  "scripts": {
    "brand:generate": "node scripts/generate-brand.cjs",
    "dev": "vite",
    "desktop:dev": "tauri dev",
    "desktop:build": "node scripts/build-desktop.mjs",
    "desktop:build:win": "node scripts/build-desktop.mjs --bundles nsis",
    "build": "pnpm typecheck && vite build",
    "typecheck": "vue-tsc --noEmit",
    "test": "cargo test --manifest-path src-tauri/Cargo.toml --locked -- --test-threads=4 && pnpm test:frontend && node tests/legacy-compatibility.mjs",
    "test:frontend": "node --test tests/*.test.mjs",
    "test:desktop": "tauri build --debug --no-bundle && node tests/desktop.mjs",
    "test:package:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-windows-package.ps1",
    "audit:ci": "pnpm audit --prod --audit-level moderate && pnpm audit --audit-level high",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.5",
    "@vicons/ionicons5": "^0.13.0",
    "naive-ui": "^2.45.3",
    "pinia": "^3.0.4",
    "vue": "^3.5.43",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "@tauri-apps/cli": "2.12.5",
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^6.0.9",
    "playwright-core": "1.63.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vue-tsc": "^3.3.12"
  }
}
